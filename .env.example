# ─────────────────────────────────────────────────────────────────────────
# Meridian Bench — environment variables
# Copy to `.env.local` for local dev. All values are server-side only except
# the two NEXT_PUBLIC_* read-side keys. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────────────────

# --- AI model access (Vercel AI Gateway) ---
# Routes every model call (any provider) through one gateway. On Vercel, OIDC
# keyless auth works automatically; for local dev set this key.
AI_GATEWAY_API_KEY=

# --- Market data (Financial Modeling Prep) ---
# Daily quotes / historical bars only. https://site.financialmodelingprep.com/
FMP_API_KEY=

# --- Supabase ---
# Server-only client (full access) — NEVER expose to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Public read-side client (safe for browser, RLS-guarded). Same project URL.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Job authentication ---
# Shared secret protecting /api/cron/*, /api/step and /api/dev/tick.
# Vercel Cron sends it automatically as `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=

# --- App ---
# Absolute base URL the orchestrator uses to self-invoke the per-participant
# worker. Local: http://localhost:3000 . On Vercel set to the deployment URL.
APP_BASE_URL=http://localhost:3000
